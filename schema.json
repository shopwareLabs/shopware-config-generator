    {
      "id": "profiler",
      "title": "Profiler & Tracing",
      "description": "Configure profiling integrations and OpenTelemetry for observability.",
      "icon": "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
      "category": "Observability",
      "groups": [
        {
          "title": "Profiler",
          "fields": [
            {
              "key": "profilerEnabled",
              "type": "toggle",
              "label": "Enable Profiler",
              "description": "Enable profiling integrations (development/staging only)",
              "default": false
            },
            {
              "key": "profilerIntegrations",
              "type": "checklist",
              "label": "Integrations",
              "default": ["Symfony"],
              "showWhen": "profilerEnabled",
              "options": [
                { "value": "Symfony", "label": "Symfony Profiler", "description": "Built-in Symfony profiler bar" },
                { "value": "Datadog", "label": "Datadog", "description": "Requires dd-trace PHP extension" },
                { "value": "Tideways", "label": "Tideways", "description": "Requires tideways PHP extension" },
                { "value": "OpenTelemetry", "label": "OpenTelemetry", "description": "Requires opentelemetry PHP extension" }
              ],
              "yaml": { "file": "shopware.yaml", "path": "shopware.profiler.integrations", "when": { "field": "profilerEnabled", "eq": true } }
            }
          ]
        },
        {
          "title": "OpenTelemetry",
          "fields": [
            {
              "key": "otelEnabled",
              "type": "toggle",
              "label": "Enable OpenTelemetry",
              "description": "Enable OpenTelemetry instrumentation",
              "default": false,
              "env": { "key": "OTEL_PHP_AUTOLOAD_ENABLED", "static": "true" },
              "infra": {
                "id": "otel",
                "label": "OTel Collector",
                "icon": "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
                "color": "#8b5cf6",
                "category": "monitoring",
                "connectionLabel": "Traces",
                "dashed": true
              }
            },
            {
              "key": "otelServiceName",
              "type": "text",
              "label": "Service Name",
              "default": "shopware",
              "hint": "Name of your service in traces",
              "placeholder": "shopware",
              "showWhen": "otelEnabled",
              "env": { "key": "OTEL_SERVICE_NAME", "when": "otelEnabled", "always": true }
            },
            {
              "key": "otelTracesExporter",
              "type": "select",
              "label": "Traces Exporter",
              "default": "otlp",
              "showWhen": "otelEnabled",
              "options": [
                { "value": "otlp", "label": "OTLP" },
                { "value": "console", "label": "Console" },
                { "value": "none", "label": "None" }
              ],
              "env": { "key": "OTEL_TRACES_EXPORTER", "when": "otelEnabled", "always": true }
            },
            {
              "key": "otelLogsExporter",
              "type": "select",
              "label": "Logs Exporter",
              "default": "otlp",
              "showWhen": "otelEnabled",
              "options": [
                { "value": "otlp", "label": "OTLP" },
                { "value": "console", "label": "Console" },
                { "value": "none", "label": "None" }
              ],
              "env": { "key": "OTEL_LOGS_EXPORTER", "when": "otelEnabled", "always": true }
            },
            {
              "key": "otelMetricsExporter",
              "type": "select",
              "label": "Metrics Exporter",
              "default": "otlp",
              "showWhen": "otelEnabled",
              "options": [
                { "value": "otlp", "label": "OTLP" },
                { "value": "console", "label": "Console" },
                { "value": "none", "label": "None" }
              ],
              "env": { "key": "OTEL_METRICS_EXPORTER", "when": "otelEnabled", "always": true }
            },
            {
              "key": "otelExporterProtocol",
              "type": "select",
              "label": "Exporter Protocol",
              "default": "grpc",
              "showWhen": "otelEnabled",
              "options": [
                { "value": "grpc", "label": "gRPC" },
                { "value": "http/protobuf", "label": "HTTP/Protobuf" },
                { "value": "http/json", "label": "HTTP/JSON" }
              ],
              "env": { "key": "OTEL_EXPORTER_OTLP_PROTOCOL", "when": "otelEnabled", "always": true }
            },
            {
              "key": "otelExporterEndpoint",
              "type": "text",
              "label": "Exporter Endpoint",
              "default": "http://localhost:4317",
              "hint": "OTLP collector endpoint",
              "placeholder": "http://localhost:4317",
              "showWhen": "otelEnabled",
              "env": { "key": "OTEL_EXPORTER_OTLP_ENDPOINT", "when": "otelEnabled", "always": true }
            }
          ]
